rules_version = '2';

/**
 * 工事予定のご連絡 の Firestore ルール。
 *
 * このアプリは GitHub Pages から配信する静的ページで、サーバーを持たない。
 * つまり**守りはすべてこのファイルに掛かっている**。画面側の JavaScript は
 * 誰でも読めるし書き換えられるので、画面のチェックは守りとして数えない。
 *
 * ログインは使わない。**トークルームに貼ったURLの中のルームIDが鍵**になる。
 * ルームIDは推測できない長さの乱数で、それを文書のIDに使っている。
 * ルールはリクエストのパスしか見られないので、
 * 「IDを知っている人だけ」を表せるのはこの形しかない。
 *
 * したがって次の2つが要点になる。
 *
 *   1. `list` を絶対に許さない。許すと一覧からIDを集められ、鍵の意味が消える
 *   2. 中身の形を検めて、関係ないものを置かれないようにする
 *
 * URLを知っている人が読み書きできるのは想定どおり。
 * そのトークルームの人が触れるようにするための作りなので。
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /renrakuWeeks/{weekId} {

      /**
       * 書き込んでよい形か。
       *
       * ログインしない相手に書かせるので、**項目も大きさも決め打ちにする**。
       * 置き場所として使われるのを防ぐため。
       */
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'roomId', 'weekStart', 'days', 'notices',
                 'finishDate', 'updatedAtISO', 'updatedAt'
               ])
          && d.roomId is string
          && d.roomId.size() >= 16 && d.roomId.size() <= 64
          && d.weekStart is string && d.weekStart.size() == 10
          // 文書のIDと中身が食い違っていたら拒む
          && weekId == d.roomId + '_' + d.weekStart
          && d.days is list && d.days.size() == 7
          && d.notices is list && d.notices.size() <= 20
          && d.finishDate is string && d.finishDate.size() <= 10
          && d.updatedAtISO is string && d.updatedAtISO.size() <= 32;
      }

      // IDを知っている人だけが読める
      allow get: if true;
      allow create, update: if valid();

      /**
       * 一覧は禁止。**ここを許すとIDを集められ、鍵が働かなくなる。**
       * 消すのも禁止。消えて困るのは入力した本人なので、画面からは消させない。
       */
      allow list, delete: if false;
    }

    /**
     * 植栽の選定チェック（shokusai/）。
     *
     * 1つの文書に、リスト（properties）・チェック（checks）・更新の依頼（updateRequest）をまとめて置く。
     *
     *   見る：文書のIDを知っている人なら誰でも。社外の渡邉樹苗園さんにもリンクで見てもらうため。
     *         IDは推測できない長さの乱数。renrakuWeeks と同じく `list` は絶対に許さない
     *   書く：・会社のPC（植栽ﾁｪｯｸ\sync.mjs）の専用アカウント … リストと状態を作り直す
     *         ・会社の Google アカウント（@archigarden.net）でログインしたスタッフ … チェック・メモ・更新の依頼だけ
     *
     * 専用アカウントのメール／パスワードでのログインは「誰でも作れる」ので、
     * スタッフかどうかは**Googleでログインしていること**まで確かめる。
     */
    match /shokusaiBoards/{boardId} {
      function isPc() {
        return request.auth != null && request.auth.uid == 'mLhqZO8VSEMTyemWyIKKlpqf4kx1';
      }
      function isStaff() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('.*@archigarden[.]net$');
      }
      function staffEdit() {
        let d = request.resource.data;
        // checks＝選定のチェック、edits＝品目の手直し・追加・削除、props＝物件の手直し・追加・削除
        return d.diff(resource.data).affectedKeys().hasOnly(['checks', 'updateRequest', 'edits', 'props'])
          && d.checks is map && d.checks.size() <= 3000
          && (!('edits' in d) || (d.edits is map && d.edits.size() <= 3000))
          && (!('props' in d) || (d.props is map && d.props.size() <= 500))
          && (!('updateRequest' in d) || d.updateRequest == null
              || (d.updateRequest is map
                  && d.updateRequest.keys().hasOnly(['atISO', 'by'])
                  && d.updateRequest.atISO is string && d.updateRequest.atISO.size() <= 32
                  && d.updateRequest.by is string && d.updateRequest.by.size() <= 40));
      }

      allow get: if true;
      allow create: if isPc();
      allow update: if isPc() || (isStaff() && staffEdit());
      allow list, delete: if false;
    }

    /**
     * 植栽チェックの外構図面（PDF）。1文書の上限が1MBなので、700KBずつに分けて置く。
     * 文書のIDは「推測できない乱数_番号」。見るのはボードと同じく、IDを知っている人だけ。
     * 置けるのは会社の Google アカウントでログインしたスタッフだけ。書き換え・削除・一覧は不可。
     */
    match /shokusaiFiles/{fileId} {
      allow get: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@archigarden[.]net$')
        && fileId.size() >= 24 && fileId.size() <= 48
        && request.resource.data.keys().hasOnly(['b64', 'n', 'of', 'by', 'atISO'])
        && request.resource.data.b64 is string && request.resource.data.b64.size() <= 1000000
        && request.resource.data.n is int && request.resource.data.of is int
        && request.resource.data.of <= 25;
      allow update, list, delete: if false;
    }

    // ここに書いていないものは全部拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
