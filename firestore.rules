rules_version = '2';

/**
 * 工事予定のご連絡 の Firestore ルール。
 *
 * このアプリは GitHub Pages から配信する静的ページで、サーバーを持たない。
 * つまり**守りはすべてこのファイルに掛かっている**。画面側の JavaScript は
 * 誰でも読めるし書き換えられるので、画面のチェックは守りとして数えない。
 *
 * ログインは使わない。**トークルームに貼ったURLの中のルームIDが鍵**になる。
 * ルームIDは推測できない長さの乱数で、それを文書のIDに使っている。
 * ルールはリクエストのパスしか見られないので、
 * 「IDを知っている人だけ」を表せるのはこの形しかない。
 *
 * したがって次の2つが要点になる。
 *
 *   1. `list` を絶対に許さない。許すと一覧からIDを集められ、鍵の意味が消える
 *   2. 中身の形を検めて、関係ないものを置かれないようにする
 *
 * URLを知っている人が読み書きできるのは想定どおり。
 * そのトークルームの人が触れるようにするための作りなので。
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /renrakuWeeks/{weekId} {

      /**
       * 書き込んでよい形か。
       *
       * ログインしない相手に書かせるので、**項目も大きさも決め打ちにする**。
       * 置き場所として使われるのを防ぐため。
       */
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'roomId', 'weekStart', 'days', 'notices',
                 'finishDate', 'updatedAtISO', 'updatedAt'
               ])
          && d.roomId is string
          && d.roomId.size() >= 16 && d.roomId.size() <= 64
          && d.weekStart is string && d.weekStart.size() == 10
          // 文書のIDと中身が食い違っていたら拒む
          && weekId == d.roomId + '_' + d.weekStart
          && d.days is list && d.days.size() == 7
          && d.notices is list && d.notices.size() <= 20
          && d.finishDate is string && d.finishDate.size() <= 10
          && d.updatedAtISO is string && d.updatedAtISO.size() <= 32;
      }

      // IDを知っている人だけが読める
      allow get: if true;
      allow create, update: if valid();

      /**
       * 一覧は禁止。**ここを許すとIDを集められ、鍵が働かなくなる。**
       * 消すのも禁止。消えて困るのは入力した本人なので、画面からは消させない。
       */
      allow list, delete: if false;
    }

    /**
     * 植栽の選定チェック（shokusai/）。
     *
     * 1つの文書に、リスト（properties）・チェック（checks）・更新の依頼（updateRequest）をまとめて置く。
     *
     *   見る：文書のIDを知っている人なら誰でも。社外の渡邉樹苗園さんにもリンクで見てもらうため。
     *         IDは推測できない長さの乱数。renrakuWeeks と同じく `list` は絶対に許さない
     *   書く：・会社のPC（植栽ﾁｪｯｸ\sync.mjs）の専用アカウント … リストと状態を作り直す
     *         ・会社の Google アカウント（@archigarden.net または @archigarden.co.jp）でログインしたスタッフ … チェック・メモ・更新の依頼だけ
     *
     * 専用アカウントのメール／パスワードでのログインは「誰でも作れる」ので、
     * スタッフかどうかは**Googleでログインしていること**まで確かめる。
     */
    match /shokusaiBoards/{boardId} {
      function isPc() {
        return request.auth != null && request.auth.uid == 'mLhqZO8VSEMTyemWyIKKlpqf4kx1';
      }
      function isStaff() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('.*@archigarden[.](net|co[.]jp)$');
      }
      function staffEdit() {
        let d = request.resource.data;
        // checks＝選定のチェック、edits＝品目の手直し・追加・削除、props＝物件の手直し・追加・削除、shares＝業者様に送ったリンクの控え
        return d.diff(resource.data).affectedKeys().hasOnly(['checks', 'updateRequest', 'edits', 'props', 'shares'])
          && (!('shares' in d) || (d.shares is map && d.shares.size() <= 100))
          && d.checks is map && d.checks.size() <= 3000
          && (!('edits' in d) || (d.edits is map && d.edits.size() <= 3000))
          && (!('props' in d) || (d.props is map && d.props.size() <= 500))
          && (!('updateRequest' in d) || d.updateRequest == null
              || (d.updateRequest is map
                  && d.updateRequest.keys().hasOnly(['atISO', 'by'])
                  && d.updateRequest.atISO is string && d.updateRequest.atISO.size() <= 32
                  && d.updateRequest.by is string && d.updateRequest.by.size() <= 40));
      }

      allow get: if true;
      allow create: if isPc();
      allow update: if isPc() || (isStaff() && staffEdit());
      allow list, delete: if false;
    }

    /**
     * 植栽チェックの外構図面（PDF）。1文書の上限が1MBなので、700KBずつに分けて置く。
     * 文書のIDは「推測できない乱数_番号」。見るのはボードと同じく、IDを知っている人だけ。
     * 置けるのは会社の Google アカウントでログインしたスタッフだけ。書き換え・削除・一覧は不可。
     */
    match /shokusaiFiles/{fileId} {
      allow get: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@archigarden[.](net|co[.]jp)$')
        && fileId.size() >= 24 && fileId.size() <= 48
        && request.resource.data.keys().hasOnly(['b64', 'n', 'of', 'by', 'atISO'])
        && request.resource.data.b64 is string && request.resource.data.b64.size() <= 1000000
        && request.resource.data.n is int && request.resource.data.of is int
        && request.resource.data.of <= 25;
      allow update, list, delete: if false;
    }

    /**
     * 植栽チェックを業者様に見せる一覧表（shokusai/share.html?s=鍵）。
     * 中身はその業者様の物件だけ（ボードの鍵は入れない）。作る・最新にする・止めるのはスタッフの画面。
     * 見るのは鍵を知っている人だけ（ログイン不要）。一覧は不可。
     */
    match /shokusaiShares/{key} {
      function isStaffG() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('.*@archigarden[.](net|co[.]jp)$');
      }
      allow get: if true;
      allow create, update: if isStaffG()
        && key.size() >= 24 && key.size() <= 48
        && request.resource.data.keys().hasOnly(['contractor', 'title', 'rows', 'stopped', 'by', 'atISO'])
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 200
        && request.resource.data.stopped is bool;
      allow list, delete: if false;
    }

    /**
     * 西村マインド学習（mind/）。西村さんへの質問と、その答え。
     *
     * 中身は役員だけのもの（人の評価・会社の線引きに関わる質問がある）なので、
     * 植栽チェックと違い**文書のIDを知っていても読めない**。読めるのは次の2つだけ。
     *   ・PC（lw-report の西村マインド学習）の専用アカウント … 質問・まとめを書き、答えを読んで取り込んだら消す
     *   ・西村さん本人（会社の Google でログイン）… 読む・answers（答え）だけ書く
     * 人の指定は uid で行う（公開リポジトリにメールアドレスを書かないため）。
     */
    match /mindBoards/{boardId} {
      function isMindPc() {
        return request.auth != null && request.auth.uid == '9M3qau8KT9REqhlFV4B7DVTG7yE3';
      }
      function isOwner() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid == 'BL0a8jFP4jTDnPVjVXRI0k0esr52';
      }
      function ownerEdit() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['answers'])
          && d.answers is map && d.answers.size() <= 300;
      }

      allow get: if isMindPc() || isOwner();
      allow create: if isMindPc();
      allow update: if isMindPc() || (isOwner() && ownerEdit());
      allow list, delete: if false;
    }

    /**
     * 設計リマインド（remind/）。
     *
     *   remindTasks/{鍵}  … 1件のリマインド。鍵は推測できない長さの乱数で、設計共有LINEに貼るリンクに入る
     *     作る・消す：西村さん（会社のGoogleでログイン）だけ
     *     見る：鍵を知っている人なら誰でも（部屋の全員が見てよい、と本人が決めた）
     *     1物件＝1件。項目（やること・確認事項）は {q, done, date, note, addedAtISO, atISO}
     *     受け手が変えてよいのは 項目の■・確認事項の日付とひとこと・締め日・済・その記録 だけ（項目の数は変えられない）
     *     西村さんが同じ物件に項目を足すと resend=true になり、PCが足した分だけ部屋へ知らせる
     *     PC（lw_report/remind.py。西村マインドと同じ専用アカウント）は送った印と知らせた印を書く
     *   remindRooms/main   … 相手と部屋の一覧（PCが探し、西村さんも編集できる）。見るのは西村さんとPCだけ
     *   remindPeople/{鍵}  … 人ごとの未済一覧（PCが作る）。毎朝のまとめのリンクで開く
     */
    match /remindTasks/{key} {
      function isOwnerR() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid == 'BL0a8jFP4jTDnPVjVXRI0k0esr52';
      }
      function isPcR() {
        return request.auth != null && request.auth.uid == '9M3qau8KT9REqhlFV4B7DVTG7yE3';
      }
      function shapeOk(d) {
        return d.keys().hasOnly([
                 'toName', 'toUserId', 'channelId', 'roomTitle', 'property', 'todos', 'checks',
                 'due', 'status', 'doneAtISO', 'createdAtISO', 'updatedAtISO',
                 'sentAtISO', 'sentError', 'resend', 'dueLog', 'events', 'notified'
               ])
          && d.toName is string && d.toName.size() <= 40
          && d.toUserId is string && d.toUserId.size() <= 64
          && d.channelId is string && d.channelId.size() <= 64
          && d.roomTitle is string && d.roomTitle.size() <= 80
          && d.property is string && d.property.size() >= 1 && d.property.size() <= 100
          && d.todos is list && d.todos.size() <= 40
          && d.checks is list && d.checks.size() <= 40
          && (d.todos.size() + d.checks.size()) >= 1
          && d.due is string && (d.due.size() == 0 || d.due.size() == 10)
          && d.status in ['open', 'done']
          && d.doneAtISO is string && d.doneAtISO.size() <= 32
          && d.createdAtISO is string && d.createdAtISO.size() <= 32
          && d.updatedAtISO is string && d.updatedAtISO.size() <= 32
          && d.sentAtISO is string && d.sentAtISO.size() <= 32
          && d.sentError is string && d.sentError.size() <= 300
          && d.resend is bool
          && d.dueLog is list && d.dueLog.size() <= 50
          && d.events is list && d.events.size() <= 200
          && d.notified is int;
      }
      function publicEdit() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'doneAtISO', 'todos', 'checks', 'due', 'dueLog', 'events', 'updatedAtISO'])
          && shapeOk(d)
          && d.checks.size() == resource.data.checks.size()
          && d.todos.size() == resource.data.todos.size()
          && d.events.size() >= resource.data.events.size();
      }

      allow get: if true;
      allow list: if isOwnerR() || isPcR();
      allow create: if isOwnerR()
        && key.size() >= 24 && key.size() <= 48
        && shapeOk(request.resource.data)
        && request.resource.data.sentAtISO == ''
        && request.resource.data.status == 'open'
        && request.resource.data.resend == false
        && request.resource.data.notified == 0
        && request.resource.data.events.size() == 0;
      allow update: if ((isOwnerR() || isPcR()) && shapeOk(request.resource.data)) || publicEdit();
      allow delete: if isOwnerR();
    }

    match /remindRooms/{docId} {
      allow get: if (request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid == 'BL0a8jFP4jTDnPVjVXRI0k0esr52')
        || (request.auth != null && request.auth.uid == '9M3qau8KT9REqhlFV4B7DVTG7yE3');
      // PC（毎日の自動探し）と、西村さん（画面の「トークルーム」タブで追加・編集・削除）が書く。
      // 西村さんが消した部屋は removed に残し、PCの自動探しでは戻さない。templates＝よく使う項目（作成欄のボタン）。
      allow create, update: if (request.auth != null && request.auth.uid == '9M3qau8KT9REqhlFV4B7DVTG7yE3')
        || (request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid == 'BL0a8jFP4jTDnPVjVXRI0k0esr52'
          && request.resource.data.keys().hasOnly(['rooms', 'removed', 'templates', 'updatedAtISO'])
          && (!('templates' in request.resource.data)
            || (request.resource.data.templates is list && request.resource.data.templates.size() <= 30))
          && request.resource.data.rooms is list && request.resource.data.rooms.size() <= 30
          && (!('removed' in request.resource.data)
            || (request.resource.data.removed is list && request.resource.data.removed.size() <= 200)));
      allow list, delete: if false;
    }

    match /remindPeople/{key} {
      allow get: if true;
      allow create, update: if request.auth != null && request.auth.uid == '9M3qau8KT9REqhlFV4B7DVTG7yE3'
        && key.size() >= 24 && key.size() <= 48;
      allow list, delete: if false;
    }

    // ここに書いていないものは全部拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
