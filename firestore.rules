rules_version = '2';

/**
 * お客様連絡アプリ の Firestore ルール。
 *
 * このアプリは GitHub Pages から配信する静的ページで、サーバーを持たない。
 * つまり**守りはすべてこのファイルに掛かっている**。画面側の JavaScript は
 * 誰でも読めるし書き換えられるので、画面のチェックは守りとして数えない。
 *
 * 線の引き方は2本だけ。
 *
 *   1. 管理側 … 会社の Google アカウントでログインした人。全部できる
 *   2. 業者側 … ログインしない。URL のトークンを知っている人だけが、
 *               自分のトークンの下だけを読み書きできる
 *
 * 業者のデータを `renrakuGyousha/{token}/weeks/...` に置いているのは、
 * **トークンをパスに含めるため**。ルールはリクエストのパスしか見られないので、
 * 「トークンを知っている人だけ」を表せるのはこの形しかない。
 * 別のコレクションに置くと、トークンが鍵として働かなくなる。
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 判定 -------------------------------------------------

    /**
     * 会社の人がログインしているか。
     *
     * メールの確認済みも見る。確認していないアドレスは名乗るだけなら誰でもできるため。
     * matches は文字列全体に一致させる決まりなので、前後に .* を置く。
     */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@archigarden[.]net');
    }

    /** そのトークンが生きているか */
    function tokenAlive(token) {
      let path = /databases/$(database)/documents/renrakuGyousha/$(token);
      return exists(path) && get(path).data.isActive == true;
    }

    /**
     * 業者が書き込もうとしている週の中身が妥当か。
     *
     * 業者に許すのは○×・作業メモ・注意事項だけ。
     * 送信済みの記録（sentAt）や割り当てには触らせない。
     */
    function validWeekWrite() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'projectId', 'projectName', 'weekStart',
               'days', 'notices', 'inputBy', 'inputAt', 'updatedAt'
             ])
        && d.days is list
        && d.days.size() == 7
        && d.inputBy == '業者';
    }

    // ---- 管理側だけが触るもの ---------------------------------

    match /renrakuProjects/{projectId}   { allow read, write: if isAdmin(); }
    match /renrakuPlanners/{plannerId}   { allow read, write: if isAdmin(); }
    match /renrakuRooms/{roomId}         { allow read, write: if isAdmin(); }
    match /renrakuSettings/{settingId}   { allow read, write: if isAdmin(); }
    match /renrakuSendLog/{logId}        { allow read, write: if isAdmin(); }

    // ---- 業者用のトークン -------------------------------------

    match /renrakuGyousha/{token} {
      /**
       * get だけを許し、list は許さない。
       *
       * これで「トークンを知っている人は自分の1件を読める」が、
       * 「一覧を取って他人のトークンを集める」ことはできなくなる。
       * **list を足すと鍵の意味が消える**ので、絶対に足さないこと。
       */
      allow get: if isAdmin() || resource.data.isActive == true;
      allow list, create, update, delete: if isAdmin();

      match /weeks/{weekId} {
        allow read: if isAdmin() || tokenAlive(token);
        allow create, update: if isAdmin()
          || (tokenAlive(token) && validWeekWrite());
        // 消すのは管理側だけ。業者の取り消しは○×を直す形で行う
        allow delete: if isAdmin();
      }
    }

    /**
     * 管理側が全業者の入力状況をまとめて見るための横断検索。
     *
     * コレクショングループ検索には、この形のルールが別に要る。
     * **管理側に限る**。ここを緩めると、トークンを1つ持っている人が
     * 他の業者の入力まで読めてしまう。
     */
    match /{path=**}/weeks/{weekId} {
      allow read: if isAdmin();
    }

    // ---- ここに書いていないものは全部拒否 ---------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
